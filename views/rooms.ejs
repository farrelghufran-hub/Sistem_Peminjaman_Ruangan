<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Ruangan - PinjamRuang FTI</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col justify-between">

    <nav class="bg-white shadow-md border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <span class="text-xl font-bold text-indigo-600 tracking-wide">🏫 PinjamRuang FTI</span>
                </div>
                <div class="flex items-center">
                    <a href="/dashboard" class="text-sm font-semibold text-gray-600 hover:text-indigo-600 transition">
                        &larr; Kembali ke Dashboard
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
        
        <div class="mb-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-800">Daftar Ruangan FTI</h1>
                <p class="text-gray-500 text-sm mt-1">Cek kapasitas dan fasilitas ruangan sebelum melakukan pengajuan peminjaman.</p>
            </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200 text-sm text-left">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="px-6 py-4 font-semibold text-gray-700 uppercase tracking-wider w-12 text-center">No</th>
                            <th scope="col" class="px-6 py-4 font-semibold text-gray-700 uppercase tracking-wider">Nama Ruangan</th>
                            <th scope="col" class="px-6 py-4 font-semibold text-gray-700 uppercase tracking-wider text-center">Kapasitas</th>
                            <th scope="col" class="px-6 py-4 font-semibold text-gray-700 uppercase tracking-wider">Fasilitas</th>
                            <th scope="col" class="px-6 py-4 font-semibold text-gray-700 uppercase tracking-wider text-center">Status Saat Ini</th>
                            <th scope="col" class="px-6 py-4 font-semibold text-gray-700 uppercase tracking-wider text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        
                        <% if (typeof ruangan !== 'undefined' && ruangan.length > 0) { %>
                            <% ruangan.forEach((r, index) => { %>
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-6 py-4 text-center text-gray-500 font-medium"><%= index + 1 %></td>
                                    <td class="px-6 py-4">
                                        <p class="text-gray-900 font-bold"><%= r.nama_ruangan %></p>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                            👥 <%= r.kapasitas %> Orang
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-gray-600">
                                        <%= r.fasilitas %>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            Tersedia
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <a href="/bookings/add?room=<%= r.ruangan_id %>" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-xs font-semibold transition shadow-sm">
                                            Ajukan Pinjam
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="px-6 py-10 text-center text-gray-500">
                                    <div class="text-4xl mb-3">📭</div>
                                    <p class="font-semibold text-lg">Belum ada data ruangan.</p>
                                    <p class="text-sm">Hubungi Penanggung Jawab untuk menambahkan master data ruangan.</p>
                                </td>
                            </tr>
                        <% } %>

                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <footer class="bg-white border-t border-gray-200 py-4 text-center text-xs text-gray-500 mt-auto">
        &copy; <%= new Date().getFullYear() %> Fakultas Teknologi Informasi Universitas Andalas. Sistem Peminjaman Ruangan Terpadu.
    </footer>

</body>
</html>